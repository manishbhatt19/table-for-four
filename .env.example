# Copy to .env and fill in. .env is gitignored — real keys never enter version control.

# --- Restaurant search (Milestone 1) ---
# Leave blank/unset to run the search server in offline fixture mode.
# Set it to enable live Google Places API (New) calls.
GOOGLE_PLACES_API_KEY=

# --- Booking backend (Milestone 2) ---
# Leave blank to drive the mock FastAPI reservation service in-process (offline,
# no port). Set it to point the booking tools at a running instance, e.g.
# started with: uv run uvicorn mock_booking_api.app:app --port 8000
BOOKING_API_URL=

# --- LLM for the orchestrator agent (Milestone 3) ---
# The agent talks to an OpenAI-compatible API, so you can use either OpenAI
# directly or OpenRouter (an aggregator: one key, many models) without code
# changes. Pick a provider with LLM_PROVIDER and fill in only that provider's key.
#
#   openai      -> direct OpenAI. Simplest; use your existing credits.
#   openrouter  -> https://openrouter.ai  One key, many models (OpenAI, Anthropic,
#                  open models). Handy for the M5 "model comparison" stretch goal.
LLM_PROVIDER=openai

# OpenAI (direct)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (OpenAI-compatible; note the different base URL). Model ids are
# namespaced, e.g. "openai/gpt-4o-mini", "anthropic/claude-3.5-sonnet",
# "meta-llama/llama-3.1-70b-instruct".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LangSmith tracing / observability (optional) ---
# Set TRACING=true and add your key to record every graph run (nodes, tool calls,
# timings, LLM prompts/tokens) to your LangSmith project. Leave TRACING unset/false
# to run with no tracing. LangGraph/LangChain pick these up automatically.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=table-for-four
